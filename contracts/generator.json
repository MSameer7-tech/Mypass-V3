{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GeneratorContracts",
  "description": "Frozen contract specifications for MyPass Password Generator operations.",
  "definitions": {
    "GeneratorOptions": {
      "type": "object",
      "properties": {
        "length": { "type": "integer", "minimum": 8, "maximum": 128 },
        "useUppercase": { "type": "boolean" },
        "useLowercase": { "type": "boolean" },
        "useDigits": { "type": "boolean" },
        "useSymbols": { "type": "boolean" }
      },
      "required": ["length", "useUppercase", "useLowercase", "useDigits", "useSymbols"]
    },
    "GeneratorResult": {
      "type": "object",
      "properties": {
        "password": { "type": "string" },
        "entropyBits": { "type": "number" }
      },
      "required": ["password", "entropyBits"]
    }
  }
}
