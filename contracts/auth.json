{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AuthContracts",
  "description": "Frozen contract specifications for MyPass AuthService operations.",
  "definitions": {
    "UnlockRequest": {
      "type": "object",
      "properties": {
        "masterPassword": { "type": "string" }
      },
      "required": ["masterPassword"]
    },
    "UnlockResult": {
      "type": "object",
      "properties": {
        "success": { "type": "boolean" },
        "sessionState": { "type": "string", "enum": ["UNLOCKED", "LOCKED", "ERROR"] },
        "errorMessage": { "type": ["string", "null"] }
      },
      "required": ["success", "sessionState"]
    }
  }
}
