{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyPass",
  "version": "3.0.0",
  "identifier": "com.isameerxo.mypass",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "",
        "width": 1180,
        "height": 720,
        "minWidth": 880,
        "minHeight": 540,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "copyright": "© 2026 Sameer",
    "resources": ["resources/ipc_bridge_app/**/*"],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {}
    },
    "fileAssociations": [
      {
        "ext": ["mypass"],
        "name": "MyPass Vault Backup",
        "description": "Encrypted backup file for MyPass",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
